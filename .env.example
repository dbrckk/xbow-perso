# Safe defaults: external engines are not executed unless explicit switches are enabled.
DRY_RUN=true
XBOW_ENABLE_ACTIVE_SCANS=false
XBOW_ENABLE_HTTP_VALIDATION=false
XBOW_ENABLE_BROWSER_AUTOMATION=false
XBOW_PORT=8080
WORKER_TIMEOUT_SECONDS=7200
XBOW_WORKER_POLL_SECONDS=1
# Maximum time a claimed job may remain abandoned before another worker recovers it.
# Keep this above the longest expected Strix run; allowed range: 60..86400 seconds.
XBOW_JOB_LEASE_SECONDS=21600
XBOW_MAX_ARTIFACT_BYTES=10485760
XBOW_MAX_STRIX_JSON_BYTES=5242880
# Active Strix scans are rejected when a campaign allows more than this local cap.
# This is an admission guard, not a claim that Strix internally enforces request pacing.
XBOW_MAX_AUTONOMOUS_RPS=2.0
XBOW_VALIDATION_TIMEOUT_SECONDS=10
XBOW_VALIDATION_MAX_BYTES=262144

# Required for every /api/* request. Generate at least 32 random characters.
# Example: openssl rand -hex 32
XBOW_API_TOKEN=

# Configure provider secrets only on the server, never commit them.
# STRIX_LLM=openai/gpt-5.4
# LLM_API_KEY=
# LLM_API_BASE=

# Browser form values are never accepted in API payloads. A fill step may only
# reference an environment variable with the XBOW_BROWSER_SECRET_ prefix.
# Inject only the exact variables needed by an authorized flow into the worker.
# XBOW_BROWSER_SECRET_TEST_LOGIN=
# XBOW_BROWSER_SECRET_TEST_PASSWORD=
