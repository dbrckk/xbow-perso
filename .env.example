# Safe defaults: external engines are not executed unless explicit switches are enabled.
DRY_RUN=true
XBOW_ENABLE_ACTIVE_SCANS=false
# Scanner engines used by the planner. "strix" preserves the historical default.
# Add nuclei only after the worker image/runtime includes a trusted Nuclei binary.
XBOW_SCAN_ENGINES=strix
XBOW_ENABLE_NUCLEI=false
# Required for active Nuclei execution. Leave blank to fail closed.
# Set only after reviewing and approving the exact installed runtime version.
XBOW_NUCLEI_ALLOWED_VERSION=
# PentAGI integration. HTTPS is mandatory and both values must be explicit.
# Current release remains fail-closed/preview-only for new remote flow dispatch:
# the local adapter cannot yet prove downstream scope/rate enforcement inside PentAGI.
# The worker/transport switches below are necessary runtime gates, not sufficient
# authorization to execute a new remote flow.
XBOW_PENTAGI_BASE_URL=
XBOW_PENTAGI_MODEL_PROVIDER=
# Legacy token source used only when the encrypted vault is disabled.
# With XBOW_VAULT_ENABLED=true, store this as the "pentagi_api_token" vault entry.
XBOW_PENTAGI_API_TOKEN=
# PentAGI remains disabled by default.
XBOW_ENABLE_PENTAGI=false
XBOW_ENABLE_PENTAGI_WORKER=false
XBOW_ENABLE_PENTAGI_TRANSPORT=false
XBOW_ENABLE_PENTAGI_STATUS_WORKER=false
# Local admission ceiling; this does not replace downstream rate enforcement.
XBOW_PENTAGI_MAX_ADMISSION_RPS=2.0
XBOW_PENTAGI_TIMEOUT_SECONDS=10
XBOW_PENTAGI_MAX_RESPONSE_BYTES=1048576
XBOW_PENTAGI_STATUS_POLL_SECONDS=10
XBOW_PENTAGI_STATUS_MAX_SECONDS=3600
XBOW_PENTAGI_STATUS_WORKER_IDLE_SECONDS=1
XBOW_ENABLE_HTTP_VALIDATION=false
XBOW_ENABLE_BROWSER_AUTOMATION=false
XBOW_PORT=8080
WORKER_TIMEOUT_SECONDS=7200
XBOW_WORKER_POLL_SECONDS=1
# Maximum time a claimed job may remain abandoned before another worker recovers it.
# Keep this above the longest expected Strix run; allowed range: 60..86400 seconds.
XBOW_JOB_LEASE_SECONDS=21600
XBOW_MAX_ARTIFACT_BYTES=10485760
XBOW_MAX_CAMPAIGN_DOCUMENT_BYTES=2097152
XBOW_MAX_JOB_PAYLOAD_BYTES=65536
XBOW_MAX_OBSERVATION_BYTES=65536
XBOW_MAX_STRIX_JSON_BYTES=5242880
# Active Strix scans are rejected when a campaign allows more than this local cap.
# This is an admission guard, not a claim that Strix internally enforces request pacing.
XBOW_MAX_AUTONOMOUS_RPS=2.0
XBOW_VALIDATION_TIMEOUT_SECONDS=10
XBOW_VALIDATION_MAX_BYTES=262144
XBOW_VALIDATION_PREVIEW_CHARS=4096

# Required for every /api/* request. Generate at least 32 random characters.
# Example: openssl rand -hex 32
XBOW_API_TOKEN=

# Configure provider secrets only on the server, never commit them.
# STRIX_LLM=openai/gpt-5.4
# LLM_API_KEY=
# PERPLEXITY_API_KEY=
# LLM_API_BASE=
# With XBOW_VAULT_ENABLED=true, store provider keys as "llm_api_key" and
# "perplexity_api_key" vault entries and leave legacy env keys unset.

# Browser form values are never accepted in API payloads. A fill step may only
# reference an environment variable with the XBOW_BROWSER_SECRET_ prefix.
# Inject only the exact variables needed by an authorized flow into the worker.
# With vault mode enabled, use names browser.<suffix-lowercase>; for example
# XBOW_BROWSER_SECRET_TEST_LOGIN becomes the vault entry browser.test_login.
# Legacy browser-secret env variables are then refused.
# XBOW_BROWSER_SECRET_TEST_LOGIN=
# XBOW_BROWSER_SECRET_TEST_PASSWORD=


# Optional distributed backend mode:
# docker compose -f docker-compose.yml -f docker-compose.distributed.yml up --build
# Keep these secrets server-side. URLs must match the credentials below.
# XBOW_POSTGRES_DB=xbow
# XBOW_POSTGRES_USER=xbow
# XBOW_POSTGRES_PASSWORD=
# XBOW_DATABASE_URL=postgresql://xbow:CHANGE_ME@postgres:5432/xbow
# XBOW_REDIS_PASSWORD=
# XBOW_REDIS_URL=redis://:CHANGE_ME@redis:6379/0


# Recon remains read-only and same-origin.
XBOW_RECON_MAX_REQUESTS=40
XBOW_RECON_MAX_DEPTH=2
XBOW_RECON_MAX_RPS=2.0


# Optional API rate limiting. Disabled by default for backward compatibility.
# Uses the direct socket client address; spoofable forwarding headers are ignored.
XBOW_API_RATE_LIMIT_ENABLED=false
XBOW_API_RATE_LIMIT_BACKEND=memory
XBOW_API_RATE_LIMIT_REQUESTS=120
XBOW_API_RATE_LIMIT_WINDOW_SECONDS=60
XBOW_API_RATE_LIMIT_MAX_KEYS=10000
# Required only when XBOW_API_RATE_LIMIT_BACKEND=redis.
XBOW_API_RATE_LIMIT_REDIS_URL=
XBOW_API_RATE_LIMIT_REDIS_PREFIX=xbow:ratelimit


# Optional HMAC key for policy receipt signatures.
# When unset, receipts still carry a SHA-256 integrity hash for tamper detection.
XBOW_AUDIT_HMAC_KEY=


# Optional encrypted local secret vault (AES-256-GCM).
# Generate a 32-byte URL-safe base64 key, e.g.:
# python -c "import os,base64; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
XBOW_VAULT_ENABLED=false
XBOW_VAULT_PATH=/data/secrets.vault.json
# Prefer the file source in production; never commit the master key.
XBOW_VAULT_MASTER_KEY=
XBOW_VAULT_MASTER_KEY_FILE=
# When enabled, api_token and audit_hmac_key must exist in the vault; legacy env/file fallback is refused.


# One-shot vault master-key rotation inputs. Configure exactly one source,
# run: PYTHONPATH=backend python -m app.vault_cli rekey
# then promote the new key to XBOW_VAULT_MASTER_KEY(_FILE) and clear these.
XBOW_VAULT_NEW_MASTER_KEY=
XBOW_VAULT_NEW_MASTER_KEY_FILE=


# Aggregate operational alert thresholds.
XBOW_ALERT_FAILED_JOBS=1
XBOW_ALERT_QUEUED_JOBS=20
XBOW_ALERT_RUNNING_JOBS=20
XBOW_ALERT_QUEUE_AGE_SECONDS=300
# Warn when unresolved crash-safe outbox intents accumulate.
XBOW_ALERT_PENDING_OUTBOX=20
# Critical alert when the oldest unresolved outbox intent exceeds this age.
XBOW_ALERT_OUTBOX_AGE_SECONDS=300


# Optional production TLS overlay:
# docker compose -f docker-compose.yml -f docker-compose.tls.yml up -d --build
# Must resolve publicly to this host for automatic ACME certificate issuance.
XBOW_PUBLIC_HOST=
# Backend accepts X-Forwarded-For only from these exact proxy addresses.
# The TLS overlay sets this automatically; do not broaden it unless required.
XBOW_TRUSTED_PROXY_CIDRS=

# Distributed Redis deployments: one planner may advance a campaign at a time.
# Keep this above normal planner execution time and below 5 minutes.
XBOW_PLANNER_LOCK_SECONDS=30

# Hard autonomy bounds for the deterministic planner. Exceeding any bound stops
# automatic progression and requires operator review. Invalid values fail closed.
XBOW_PLANNER_MAX_OBSERVATIONS=5000
XBOW_PLANNER_MAX_ENDPOINTS=1500
XBOW_PLANNER_MAX_FINDINGS=250

# Durable execution budgets used by the campaign orchestrator. These values bound
# autonomous fan-out and runtime; invalid or inconsistent values fail closed.
XBOW_PLANNER_MAX_ACTIONS=50
XBOW_PLANNER_MAX_SCANS=3
XBOW_PLANNER_MAX_VALIDATIONS=25
XBOW_PLANNER_MAX_VALIDATION_BATCH=10
XBOW_PLANNER_MAX_REPORTS=5
XBOW_PLANNER_MAX_INFLIGHT_JOBS=12
XBOW_PLANNER_MAX_FAILED_JOBS=5
XBOW_CAMPAIGN_MAX_RUNTIME_SECONDS=21600

# Dedicated scanner worker / sandbox. Active scanner execution is admitted only
# inside the restricted scanner worker profile. Default engine allowlist keeps
# Strix disabled until its runtime contract is reviewed explicitly.
XBOW_ENABLE_NUCLEI=false
XBOW_SCANNER_ALLOWED_ENGINES=nuclei
XBOW_NUCLEI_ALLOWED_VERSION=
XBOW_SCANNER_SANDBOX_PROFILE=restricted-v1


# Optional TOTP second factor for mutating /api requests (POST/PUT/PATCH/DELETE).
# Use a base32 secret of at least 80 bits. When vault mode is enabled, store it
# as the "totp_secret" vault entry and leave XBOW_TOTP_SECRET blank.
XBOW_TOTP_ENABLED=false
XBOW_TOTP_SECRET=
# Single-instance default. Distributed deployments override this to Redis.
XBOW_TOTP_REPLAY_BACKEND=memory
XBOW_TOTP_REPLAY_REDIS_URL=


# Optional external alert delivery. The destination is server-configured only,
# must be HTTPS, and receives aggregate/redacted alert fields only.
XBOW_ALERT_WEBHOOK_URL=
XBOW_ALERT_WEBHOOK_TIMEOUT_SECONDS=5
# Optional legacy signing key. With vault mode enabled, store it as
# "alert_webhook_hmac_key" and leave this variable unset.
XBOW_ALERT_WEBHOOK_HMAC_KEY=
