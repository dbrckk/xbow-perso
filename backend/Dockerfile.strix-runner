FROM debian:bookworm-slim AS fetch

ARG TARGETARCH
ARG STRIX_VERSION=1.6.2
ARG STRIX_SOURCE_COMMIT=ff5c8cc8e46d8e60c2bc2439f7bcb07c05ca3db2

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl \
    && case "$TARGETARCH" in \
         amd64) \
           RELEASE_ARCH=x86_64; \
           ARCHIVE_SHA256=f3f29fa64bee420bf64f8911fb9f38e20270d406f6df44cc2436252c2af0bc81 \
           ;; \
         arm64) \
           RELEASE_ARCH=arm64; \
           ARCHIVE_SHA256=4a4cba115bda8b89d7bbfabe960246a480ff43563144959b2e33477955aa6df2 \
           ;; \
         *) echo "unsupported TARGETARCH: $TARGETARCH" >&2; exit 1 ;; \
       esac \
    && ASSET="strix-${STRIX_VERSION}-linux-${RELEASE_ARCH}.tar.gz" \
    && URL="https://github.com/usestrix/strix/releases/download/v${STRIX_VERSION}/${ASSET}" \
    && curl --fail --location --proto '=https' --tlsv1.2 "$URL" -o "/tmp/${ASSET}" \
    && printf '%s  %s\n' "$ARCHIVE_SHA256" "/tmp/${ASSET}" | sha256sum -c - \
    && mkdir -p /opt/strix \
    && tar -C /opt/strix -xzf "/tmp/${ASSET}" \
    && mv "/opt/strix/strix-${STRIX_VERSION}-linux-${RELEASE_ARCH}" /opt/strix/strix \
    && chmod 0755 /opt/strix/strix \
    && /opt/strix/strix --version | grep -Fx "strix ${STRIX_VERSION}" \
    && BINARY_SHA256="$(sha256sum /opt/strix/strix | awk '{print $1}')" \
    && printf '{"schema":"strix-runner-attestation-v1","version":"%s","source_commit":"%s","asset_name":"%s","archive_sha256":"%s","binary_sha256":"%s","platform":"linux","architecture":"%s"}\n' \
         "$STRIX_VERSION" \
         "$STRIX_SOURCE_COMMIT" \
         "$ASSET" \
         "$ARCHIVE_SHA256" \
         "$BINARY_SHA256" \
         "$TARGETARCH" \
         > /opt/strix/manifest.json \
    && chmod 0444 /opt/strix/manifest.json \
    && rm -rf /tmp/* /var/lib/apt/lists/*


FROM python:3.12-slim AS runner

RUN groupadd --system --gid 65532 strix-runner \
    && useradd --system --uid 65532 --gid 65532 --home-dir /nonexistent \
       --shell /usr/sbin/nologin strix-runner \
    && mkdir -p /app/app \
    && chown -R root:root /app

COPY --from=fetch /opt/strix /opt/strix
COPY app/strix_runner_attestation.py /app/app/strix_runner_attestation.py

RUN chmod 0555 /opt/strix/strix \
    && chmod 0444 /opt/strix/manifest.json \
    && chmod 0444 /app/app/strix_runner_attestation.py

WORKDIR /app
ENV PYTHONUNBUFFERED=1 \
    PATH="/opt/strix:${PATH}" \
    HOME=/tmp \
    XBOW_STRIX_ACTIVE_EXECUTION=false

USER 65532:65532

CMD ["python", "-m", "app.strix_runner_attestation", "--idle"]
