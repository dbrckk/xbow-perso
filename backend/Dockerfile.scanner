FROM python:3.12-slim AS scanner-runtime

ARG TARGETARCH
ARG NUCLEI_VERSION=3.11.1
ARG NUCLEI_TEMPLATES_VERSION=10.4.8

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl unzip \
    && case "$TARGETARCH" in \
         amd64) NUCLEI_SHA256=ea63d4ae232808cd7c6bc00d0142428e231fab59dae01042246097d195835ab6 ;; \
         arm64) NUCLEI_SHA256=8044e3d9768ba0a744b2872c1a87e813006f013da97ca9f50f7661a4203bec07 ;; \
         *) echo "unsupported TARGETARCH: $TARGETARCH" >&2; exit 1 ;; \
       esac \
    && NUCLEI_ARCHIVE="nuclei_${NUCLEI_VERSION}_linux_${TARGETARCH}.zip" \
    && curl --fail --location --proto '=https' --tlsv1.2 \
       "https://github.com/projectdiscovery/nuclei/releases/download/v${NUCLEI_VERSION}/${NUCLEI_ARCHIVE}" \
       -o "/tmp/${NUCLEI_ARCHIVE}" \
    && printf '%s  %s\n' "$NUCLEI_SHA256" "/tmp/${NUCLEI_ARCHIVE}" | sha256sum -c - \
    && unzip -q "/tmp/${NUCLEI_ARCHIVE}" nuclei -d /usr/local/bin \
    && chmod 0755 /usr/local/bin/nuclei \
    && nuclei -version \
    && curl --fail --location --proto '=https' --tlsv1.2 \
       "https://github.com/projectdiscovery/nuclei-templates/releases/download/v${NUCLEI_TEMPLATES_VERSION}/nuclei-templates-${NUCLEI_TEMPLATES_VERSION}_checksums.txt" \
       -o /tmp/templates-checksums.txt \
    && printf '%s  %s\n' "a69201662fc005843ef2bdac7cf494787a354fda29957d4122a5bb3622effbca" "/tmp/templates-checksums.txt" | sha256sum -c - \
    && curl --fail --location --proto '=https' --tlsv1.2 \
       "https://github.com/projectdiscovery/nuclei-templates/archive/refs/tags/v${NUCLEI_TEMPLATES_VERSION}.tar.gz" \
       -o /tmp/nuclei-templates.tar.gz \
    && mkdir -p /opt/nuclei-templates \
    && tar -xzf /tmp/nuclei-templates.tar.gz --strip-components=1 -C /opt/nuclei-templates \
    && test -f /opt/nuclei-templates/templates-checksum.txt \
    && printf 'nuclei-templates-v10.4.8\n' > /opt/nuclei-templates/.xbow-version \
    && rm -rf /tmp/* /var/lib/apt/lists/*

WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt \
    && python -m playwright install --with-deps chromium \
    && rm -rf /var/lib/apt/lists/*
COPY app ./app

ENV PYTHONUNBUFFERED=1 \
    NUCLEI_TEMPLATES_DIRECTORY=/opt/nuclei-templates

CMD ["python", "-m", "app.worker_service"]
